# Backend
APP_NAME=RetailData-Pro API
APP_ENV=development
API_CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://retaildata_user:change-me@localhost:5432/retaildata_pro
READONLY_DATABASE_URL=postgresql+psycopg://retaildata_readonly:change-me@localhost:5432/retaildata_pro
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_STRUCTURED_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
AI_PROVIDER_TIMEOUT_SECONDS=30
AI_PROVIDER_MAX_RETRIES=2
RAG_DENSE_TOP_K=20
RAG_LEXICAL_TOP_K=20
RAG_RRF_K=60
RAG_RERANK_TOP_K=8
RAG_CONTEXT_TOP_K=6
GEMINI_35_FLASH_LITE_INPUT_COST_PER_1M=0.30
GEMINI_35_FLASH_LITE_OUTPUT_COST_PER_1M=2.50
GEMINI_36_FLASH_INPUT_COST_PER_1M=1.50
GEMINI_36_FLASH_OUTPUT_COST_PER_1M=7.50

# Frontend
VITE_API_BASE_URL=http://localhost:8000
